# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ats_resume?retryWrites=true&w=majority
# If SRV DNS fails on Windows (querySrv ETIMEOUT), paste Atlas "mongodb://" standard URI here:
# MONGODB_URI_STANDARD=mongodb://user:pass@host1:27017,host2:27017/ats_resume?replicaSet=...&ssl=true

# OpenAI API & Credits Tracking
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ADMIN_KEY=your_openai_admin_key_here # Optional: sk-admin-... for automated live organization usage sync
OPENAI_TOTAL_CREDITS=12.69 # Optional: Total initial credits pool in USD

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Client Origin (for CORS)
CLIENT_ORIGIN=http://localhost:5173

# Email Service Configuration
EMAIL_SERVICE=gmail  # or leave blank for custom SMTP
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password  # Use Gmail App Password, not regular password
CLIENT_URL=http://localhost:5173  # Your frontend URL

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Cloudinary Storage (Production Image & Portfolio CDN)
# Get free credentials at: https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=defv51nnt
CLOUDINARY_API_KEY=132285513573928
CLOUDINARY_API_SECRET=EmlhimzfyzA9V6p_cESQDcNAwDk

# ==========================================
# SECURITY CONFIGURATION
# ==========================================

# Allowed Origins for CORS (comma-separated)
# Examples:
# - Development: http://localhost:5173,http://localhost:3000
# - Production: https://yourdomain.com,https://www.yourdomain.com
# - Wildcard: https://*.yourdomain.com (matches any subdomain)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ==========================================
# OAUTH AUTHENTICATION
# ==========================================

# Google OAuth
# Get credentials from: https://console.cloud.google.com/
# 1. Create new project
# 2. Enable Google+ API
# 3. Create OAuth 2.0 Client ID
# 4. Add authorized redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# GitHub OAuth
# Get credentials from: https://github.com/settings/developers
# 1. Click "New OAuth App"
# 2. Add callback URL: http://localhost:5000/api/auth/github/callback
GITHUB_CLIENT_ID=your-github-client-id-here
GITHUB_CLIENT_SECRET=your-github-client-secret-here

# Session Secret (for Passport.js)
# Generate a random string (e.g., openssl rand -base64 32)
SESSION_SECRET=your-random-session-secret-change-in-production

# Server URL (for OAuth callbacks)
SERVER_URL=http://localhost:5000

# ==========================================
# VOICE SERVICES (AI Interview)
# ==========================================

# OpenAI API Key (required for AI interview question generation & evaluation)
OPENAI_API_KEY=your_openai_api_key_here

# Sarvam AI API Key (Production STT & TTS: Saaras v3 + Bulbul v3)
# Get your API key from: https://dashboard.sarvam.ai
# When set, production voice synthesis & transcription will use Sarvam AI cloud
SARVAM_API_KEY=your_sarvam_api_key_here

# Whisper STT Service URL (Speech-to-Text local development fallback)
VOICE_SERVICE_URL=http://localhost:5001
ML_SERVICE_URL=http://localhost:5001

# Chatterbox TTS Service URL (Text-to-Speech local development fallback)
CHATTERBOX_SERVICE_URL=http://localhost:5002

# ==========================================
# PRODUCTION NOTES
# ==========================================
# For production deployment:
# - Change all secrets to strong random strings
# - Use HTTPS URLs (https://your-domain.com)
# - Update OAuth callback URLs in provider settings
# - Set NODE_ENV=production
