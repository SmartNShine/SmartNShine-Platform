{
    "name": "smartnshine-server",
    "version": "1.0.0",
    "description": "Backend API for SmartNShine Resume Builder",
    "main": "server.js",
    "type": "module",
    "scripts": {
        "dev-v": "node --env-file=.env --watch server.js",
        "dev": "nodemon --exec \"node --env-file=.env\" server.js",
        "dev:native": "node --env-file=.env --watch-path=./routes --watch-path=./controllers --watch-path=./models --watch-path=./middleware --watch-path=./services --watch-path=./utils --watch-path=./config --watch-path=./server.js --watch-preserve-output server.js",
        "start": "node server.js",
        "create-admin": "node --env-file=.env scripts/createAdmin.js",
        "sync:templates": "node --env-file=.env scripts/syncTemplates.js",
        "check:templates": "node --env-file=.env scripts/checkTemplates.js",
        "find:duplicates": "node --env-file=.env scripts/listDuplicateTemplates.js",
        "dedupe:templates": "node --env-file=.env scripts/dedupeTemplates.js",
        "migrate:resume-titles": "node --env-file=.env scripts/migrateResumeTitles.js",
        "migrate:users": "node --env-file=.env scripts/migrateUsers.js",
        "test:models": "node --env-file=.env scripts/testModels.js",
        "test:interview": "node --test tests/proctoring.test.js tests/interview-algorithm.test.js",
        "cleanup:plans:dry": "node scripts/cleanup-production-plans.js --dry-run",
        "cleanup:plans:backup": "node scripts/cleanup-production-plans.js --backup --force",
        "cleanup:plans": "node scripts/cleanup-production-plans.js --force"
    },
    "keywords": [
        "resume",
        "ats",
        "ai",
        "openai"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "axios": "^1.7.9",
        "bcryptjs": "^2.4.3",
        "connect-mongo": "^5.1.0",
        "cors": "^2.8.5",
        "dodopayments": "^2.6.1",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "express-mongo-sanitize": "^2.2.0",
        "express-rate-limit": "^8.1.0",
        "express-session": "^1.18.2",
        "express-validator": "^7.3.0",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.2",
        "mammoth": "^1.8.0",
        "mongoose": "^8.9.3",
        "multer": "^1.4.5-lts.1",
        "node-fetch": "^3.3.2",
        "nodemailer": "^7.0.10",
        "openai": "^4.52.0",
        "passport": "^0.7.0",
        "passport-github2": "^0.1.12",
        "passport-google-oauth20": "^2.0.0",
        "pdf-parse": "1.1.1",
        "pdf.js-extract": "^0.2.1",
        "puppeteer": "^24.43.1",
        "razorpay": "^2.9.2",
        "sarvamai": "^1.1.9",
        "validator": "^13.15.20",
        "xss-clean": "^0.1.4"
    },
    "devDependencies": {
        "nodemon": "^3.1.11"
    }
}
