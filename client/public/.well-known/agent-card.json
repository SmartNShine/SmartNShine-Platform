{
  "$schema": "https://a2a-protocol.org/schema/v1/agent-card.json",
  "type": "https://schema.org/SoftwareApplication",
  "name": "SmartNShine",
  "title": "SmartNShine ATS Resume & Career Agent",
  "description": "Enterprise-grade Agent-to-Agent (A2A) Card for ATS resume optimization, scoring, and career intelligence",
  "url": "https://www.smartnshine.in",
  "version": "2.0.0",
  "provider": {
    "name": "SmartNShine",
    "url": "https://www.smartnshine.in",
    "contact": "contact@smartnshine.in"
  },
  "protocols": [
    "MCP",
    "WebMCP",
    "ACP",
    "REST",
    "OpenAPI"
  ],
  "endpoints": {
    "openapi": "https://www.smartnshine.in/openapi.json",
    "mcp": "https://www.smartnshine.in/.well-known/mcp.json",
    "webmcp": "https://www.smartnshine.in/.well-known/webmcp.json",
    "api_catalog": "https://www.smartnshine.in/.well-known/api-catalog",
    "skills": "https://www.smartnshine.in/.well-known/skills.json",
    "documentation": "https://www.smartnshine.in/AGENTS.md"
  },
  "skills": [
    {
      "name": "generate_ats_resume",
      "description": "Creates an ATS-compliant resume tailored for specific job postings",
      "input_schema": {
        "type": "object",
        "properties": {
          "job_description": { "type": "string" },
          "target_role": { "type": "string" }
        }
      }
    },
    {
      "name": "analyze_ats_score",
      "description": "Scores an existing resume against target ATS criteria and keywords",
      "input_schema": {
        "type": "object",
        "properties": {
          "resume_text": { "type": "string" },
          "job_description": { "type": "string" }
        }
      }
    },
    {
      "name": "recommend_template",
      "description": "Selects the optimal resume template based on industry and experience level",
      "input_schema": {
        "type": "object",
        "properties": {
          "industry": { "type": "string" },
          "experience_level": { "type": "string" }
        }
      }
    }
  ]
}
